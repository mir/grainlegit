#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
if [[ "$(uname -s)" == Darwin ]]; then
  default_sdk="$HOME/Library/Android/sdk"
else
  default_sdk="$HOME/Android/Sdk"
fi
sdk="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$default_sdk}}"
export ANDROID_HOME="$sdk"
adb="$sdk/platform-tools/adb"
apk="$repo/android/app/build/outputs/apk/debug/app-debug.apk"
ndk_version=29.0.14206865

case "${1:-build}" in
  setup)
    sdkmanager="$sdk/cmdline-tools/latest/bin/sdkmanager"
    if [[ ! -x "$sdkmanager" ]]; then
      printf 'Install Android SDK Command-line Tools (latest) in %s first.\n' "$sdk" >&2
      exit 1
    fi
    "$sdkmanager" --sdk_root="$sdk" --licenses
    "$sdkmanager" --sdk_root="$sdk" 'platform-tools' 'platforms;android-36' 'build-tools;36.0.0' "ndk;$ndk_version"
    rustup toolchain install 1.92.0 --profile minimal --component rustfmt --target aarch64-linux-android
    ;;
  build|install|run)
    "$repo/android/gradlew" -p "$repo/android" :app:assembleDebug
    if [[ "${1:-build}" != build ]]; then
      soc=$("$adb" shell getprop ro.soc.model | tr -d '\r')
      if [[ "$soc" == [Ss][Mm]8850 ]] &&
         ! unzip -Z1 "$apk" assets/models/sm8850/sam31/encoder-sm8850_qnn.bin >/dev/null 2>&1; then
        printf 'This SM8850 phone needs a debug APK with SAM 3.1. Set GRAINLEGIT_SAM31_MODEL_DIR to the compiled model directory and retry.\n' >&2
        exit 1
      fi
      "$adb" install -r "$apk"
    fi
    if [[ "${1:-build}" == run ]]; then
      "$adb" shell am start -W -n dev.grainlegit.editor.dev/dev.grainlegit.editor.MainActivity
    fi
    ;;
  devices)
    "$adb" devices -l
    ;;
  logs)
    "$adb" logcat -s Grainlegit
    ;;
  verify)
    "$sdk/build-tools/36.0.0/zipalign" -c -P 16 4 "$apk"
    native_file=$(mktemp)
    trap 'rm -f "$native_file"' EXIT
    unzip -p "$apk" lib/arm64-v8a/libgrainlegit_renderer.so > "$native_file"
    case "$(uname -s)" in
      Darwin) ndk_host=darwin-x86_64 ;;
      Linux) ndk_host=linux-x86_64 ;;
      *) printf 'Unsupported verification host.\n' >&2; exit 1 ;;
    esac
    readelf="$sdk/ndk/$ndk_version/toolchains/llvm/prebuilt/$ndk_host/bin/llvm-readelf"
    load_alignments=$("$readelf" -lW "$native_file" | awk '$1 == "LOAD" { print $NF }')
    [[ -n "$load_alignments" ]]
    for alignment in $load_alignments; do
      if (( alignment < 0x4000 )); then
        printf 'Native ELF segment has alignment %s, below 16 KiB.\n' "$alignment" >&2
        exit 1
      fi
    done
    printf 'APK and arm64 renderer pass 16 KiB alignment checks.\n'
    ;;
  *)
    printf 'Usage: %s [setup|build|install|run|devices|logs|verify]\n' "$0" >&2
    exit 2
    ;;
esac
